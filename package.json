{
  "name": "takeover-triage",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -b packages/engine packages/seedgen apps/forge && tsc -p tsconfig.test.json && tsc -p apps/forge/tsconfig.test.json && pnpm --filter @tt/ui-shared --filter \"@tt/static-*\" typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:manifest": "pnpm --filter @tt/forge validate:manifest",
    "validate:manifest:strict": "node apps/forge/scripts/validate-manifest.mjs --strict",
    "build:engine": "tsc -b packages/engine packages/seedgen",
    "build:ui": "pnpm --filter \"@tt/static-*\" build",
    "build": "pnpm build:engine && pnpm build:ui",
    "check:size": "node apps/forge/scripts/check-bundle-size.mjs",
    "check:bundle": "node apps/forge/scripts/forge-bundle-check.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate:manifest",
    "check:deploy": "pnpm build && pnpm validate:manifest:strict && pnpm check:size && pnpm check:bundle"
  },
  "devDependencies": {
    "@atlaskit/button": "25.7.0",
    "@atlaskit/css-reset": "8.4.10",
    "@atlaskit/dynamic-table": "19.3.8",
    "@atlaskit/heading": "8.0.0",
    "@atlaskit/lozenge": "17.0.6",
    "@atlaskit/primitives": "22.6.0",
    "@atlaskit/section-message": "10.2.6",
    "@atlaskit/spinner": "20.4.4",
    "@atlaskit/tokens": "20.9.0",
    "@atlaskit/tooltip": "24.4.3",
    "@eslint/js": "^9.39.0",
    "@forge/bridge": "7.2.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "^9.39.0",
    "fast-check": "^4.3.0",
    "jsdom": "31.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.6",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-view": "1.42.4"
    }
  }
}
